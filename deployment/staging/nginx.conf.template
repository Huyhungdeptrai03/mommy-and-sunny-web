map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
# Deliberately omit query, Authorization, cookies and request body from logs.
log_format qa_safe '$remote_addr $request_method $uri $status $body_bytes_sent';
server {
    listen 443 ssl;
    server_name ${STAGING_HOST};
    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/access.log qa_safe;
    # nginx error logs can contain full upstream request URIs. Suppress ordinary
    # per-request errors here; collect redacted application metrics separately.
    error_log /var/log/nginx/error.log crit;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    add_header X-Content-Type-Options nosniff always;
    if ($host != '${STAGING_HOST}') { return 444; }
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host '';
    proxy_set_header Forwarded '';
    proxy_http_version 1.1;
    location /api/ {
        proxy_pass http://api:8080;
        proxy_cache off;
    }
    location /hubs/chat {
        proxy_pass http://api:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host '';
        proxy_set_header Forwarded '';
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 90s;
    }
    location / {
        proxy_pass http://web:3000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host '';
        proxy_set_header Forwarded '';
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# Runtime only: copy to secrets/api.env (chmod 600), fill with isolated values.
# Connection must use the Compose service postgres and the QA role/database below.
ConnectionStrings__DefaultConnection=
Jwt__Secret=
Jwt__Issuer=
Jwt__Audience=
Jwt__AccessTokenExpirationMinutes=15
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Facebook__AppId=
Authentication__Facebook__AppSecret=
# Dedicated test inbox / SMTP capture service, STARTTLS with trusted certificate.
# Current SmtpEmailSender uses EnableSsl=true; plain SMTP/implicit TLS is unsuitable.
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=MommyAndSunny QA
# Staging requires non-empty non-mock options. Supply ONLY documented test values;
# if no safe provider test account exists, leave blocked and use the separate QA mock stack.
SePay__Bank=
SePay__AccountNumber=
SePay__WebhookApiKey=
